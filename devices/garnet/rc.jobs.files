# Commands run by the launchd job com.redwood.demo (see com.redwood.demo.plist).
/redwood/bin/hello_dyn started by launchd
# --- the Files app, with nobody at the phone (test only): the lock screen swiped away, Files opened by its URL
# scheme, its Browse list of locations shown, and what the file provider daemon has in its containers ---
/redwood/bin/rwtouch wait 40 swipe 0.5 0.985 0.5 0.3 200 wait 8
/var/jb/usr/bin/uiopen shareddocuments://
/redwood/bin/rwtouch wait 15 tap 0.12 0.081 wait 10
/var/jb/usr/bin/find /var/mobile/Containers/Shared/AppGroup -maxdepth 3
/var/jb/usr/bin/find /var/mobile/Library/Application?Support/FileProvider -maxdepth 3
/bin/ps -A
