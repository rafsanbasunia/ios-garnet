# The POCO X6 5G (garnet): what is this phone's own. Included by garnet_defconfig after the common kernel and sm7435.config.
CONFIG_DEVICE="garnet"

# drivers
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_GOODIX=n
CONFIG_HAKIOS_FOCALTECH=y
CONFIG_HAKIOS_ADRENO=n
CONFIG_HAKIOS_ADRENO710=y
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_WIFI=y
CONFIG_HAKIOS_BT=n
CONFIG_HAKIOS_BTQCA=y

# what the common kernel and the SoC's fragment turn on that is another phone's, or not tried on this one
# CONFIG_UFS is not set
# CONFIG_TOUCHSCREEN is not set
# CONFIG_CPUFREQ is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_SOCINFO is not set
# CONFIG_THERMAL is not set

# touch and buttons
CONFIG_GARNET_TOUCH=y
CONFIG_GARNET_BUTTONS=y
CONFIG_GARNET_CPUFREQ=y

# GPU: the Adreno 710 at its top level (940 MHz), CoreAnimation through Metal with GMEM tiles
CONFIG_GPU=y
CONFIG_GL=y
CONFIG_ADRENO_SPEED=8
CONFIG_DDR=2
CONFIG_METAL=y
CONFIG_METAL_ALL=y
CONFIG_CA_METALLIB="/redwood/share/QuartzCore-default.metallib"
CONFIG_METAL_GMEM=y
CONFIG_METAL_GMEM_DRAWS=24
CONFIG_FB_THREADS=6
CONFIG_FB_INTF=0x0ae36000
CONFIG_FB_QUEUE=y
CONFIG_FB_HZ=120
CONFIG_UI_LITE=y
CONFIG_CAENV="CA_DISABLE_DIRTY_REGIONS=1"
CONFIG_GPU_RECOVER=y
CONFIG_WALLPAPER_FREEZE=y

# Wi-Fi: the WPSS DSP and Linux ath10k, brought up beside the boot (firmware: pull-firmware.sh)
CONFIG_WIFI=y
